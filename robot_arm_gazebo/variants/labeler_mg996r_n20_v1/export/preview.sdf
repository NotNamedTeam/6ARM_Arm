<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.10">
  <world name="freecad_robot_arm">
    <physics name="robot_physics" type="ignored">
      <max_step_size>.0005</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <scene>
      <ambient>.65 .65 .65 1</ambient>
      <background>.93 .94 .96 1</background>
    </scene>
    <light name="sun" type="directional">
      <pose>0 0 3 0 0 0</pose>
      <diffuse>.85 .85 .85 1</diffuse>
      <direction>-.5 -.3 -1</direction>
    </light>
    <include>
      <uri>model://robot_arm_freecad</uri>
    </include>
    <model name="ground">
      <static>true</static>
      <link name="ground">
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>2 2</size>
            </plane>
          </geometry>
          <material>
            <ambient>.76 .78 .8 1</ambient>
            <diffuse>.76 .78 .8 1</diffuse>
          </material>
        </visual>
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>2 2</size>
            </plane>
          </geometry>
        </collision>
      </link>
    </model>
    <model name="carton_reference">
      <static>true</static>
      <link name="carton">
        <pose>.01 .17 .32 0 0 0</pose>
        <visual name="carton_visual">
          <geometry>
            <box>
              <size>.25 .15 .30</size>
            </box>
          </geometry>
          <material>
            <ambient>.65 .48 .31 1</ambient>
            <diffuse>.65 .48 .31 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>